rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile documents & activity history
    match /users/{userId} {
      allow read, write: if true;
      match /activities/{activityId} {
        allow read, write: if true;
      }
    }

    // Dreams collection
    match /dreams/{dreamId} {
      allow read, write: if true;
    }

    // Direct messages
    match /messages/{threadId} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
